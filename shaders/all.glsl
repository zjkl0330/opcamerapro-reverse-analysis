// ===== #277 off=0x074352b stage=vert len=5605 =====
#version 440

layout(location = 0) in vec2 vTexCoord;

layout(location = 0) out mediump vec4 fragColor;

layout(std140, binding = 0) uniform UniformBlock {
    // Lut
    mediump int lutOn;
    mediump float lutIntensity;
    mediump float lutHdrTonemapExposure;
    mediump float lutHdrTonemapGamma;

    mediump float lutTexelSize1D; // 1 / (level count)
    mediump float lutRgbToTexCoordRatio;
    mediump int lutIsRGBLayout;

    mediump float lutTexelSize1D2; // 1 / (level count)
    mediump float lutRgbToTexCoordRatio2;
    mediump int lutIsRGBLayout2;

    mediump float lutIntpFactor;

    // Noise
    mediump int noiseOn;
    mediump int colorNoise;
    mediump float colorRatio;
    mediump float noiseTexWidth;
    mediump float noiseTexHeight;
    mediump float noiseRandomOffsetX;
    mediump float noiseRandomOffsetY;
    mediump float noiseAmount;
    mediump float noiseHighlight;
    mediump float noiseMidtone;
    mediump float noiseMidtoneHigh;
    mediump float noiseShadow;
    mediump float noiseSize;
    mediump float noiseRoughness;
    mediump int noiseUseNewCurve;

    // PT400
    mediump float pt400ShadowThresh;
    mediump float pt400ShadowOpacity;
    mediump float pt400HighlightOpacity;
    mediump int isSDR;

    // Common
    mediump float imageWidth;
    mediump float imageHeight;
    mediump int hdrTransfer;
    mediump int hdrInvertTransfer;  // TODO.
} ubuf;

layout(binding = 2) uniform mediump sampler2D texSampler;
layout(binding = 3) uniform mediump sampler2D lutSampler;
layout(binding = 4) uniform mediump sampler2D lutSampler2;
layout(binding = 5) uniform mediump sampler2D noiseSampler;
layout(binding = 6) uniform mediump sampler2D auxSampler;

#extension GL_GOOGLE_include_directive:enable
#include "../hdr.inc.shader"
#include "../compoundLutCommon.inc.shader"
#include "../common.inc.shader"
#include "../pt400.inc.shader"

void main()
{
    mediump vec4 currentColor = texture(texSampler, vTexCoord);

    if (ubuf.hdrTransfer == 1)
        currentColor.rgb = ColorRangeTransfer(currentColor.rgb, 1);

    // PT400 low quality
    if (ubuf.pt400ShadowThresh > 0.f) {
        mediump vec4 blurColor = texture(auxSampler, vTexCoord);
        mediump float luma = dot(currentColor.rgb, vec3(0.2126, 0.7152, 0.0722));
        currentColor.rgb = processPT400LowQuality(blurColor,
                                                  currentColor.rgb,
                                                  ubuf.isSDR,
                                                  luma,
                                                  ubuf.pt400ShadowThresh,
                                                  ubuf.pt400ShadowOpacity,
                                                  ubuf.pt400HighlightOpacity);
    }

    //process lut
    if (ubuf.lutOn == 1) {
        if (ubuf.lutIntpFactor <= 0.0)
            currentColor.rgb = lut3D2446A(currentColor.rgb,
                                          ubuf.lutTexelSize1D,
                                          ubuf.lutRgbToTexCoordRatio,
                                          ubuf.lutIntensity,
                                          ubuf.lutIsRGBLayout,
                                          ubuf.lutHdrTonemapExposure,
                                          ubuf.lutHdrTonemapGamma);
        else if (ubuf.lutIntpFactor >= 1.0)
            currentColor.rgb = lut3D2446A2(currentColor.rgb,
                                           ubuf.lutTexelSize1D2,
                                           ubuf.lutRgbToTexCoordRatio2,
                                           ubuf.lutIntensity,
                                           ubuf.lutIsRGBLayout2,
                                           ubuf.lutHdrTonemapExposure,
                                           ubuf.lutHdrTonemapGamma);
        else {
            mediump vec3 lutColor = lut3D2446A(currentColor.rgb,
                                               ubuf.lutTexelSize1D,
                                               ubuf.lutRgbToTexCoordRatio,
                                               ubuf.lutIntensity,
                                               ubuf.lutIsRGBLayout,
                                               ubuf.lutHdrTonemapExposure,
                                               ubuf.lutHdrTonemapGamma);
            mediump vec3 lutColor2 = lut3D2446A2(currentColor.rgb,
                                                 ubuf.lutTexelSize1D2,
                                                 ubuf.lutRgbToTexCoordRatio2,
                                                 ubuf.lutIntensity,
                                                 ubuf.lutIsRGBLayout2,
                                                 ubuf.lutHdrTonemapExposure,
                                                 ubuf.lutHdrTonemapGamma);
            lutColor = mix(lutColor, lutColor2, ubuf.lutIntpFactor);
            currentColor.rgb = lutColor;
        }
    }

    if (ubuf.noiseOn == 1) {
        vec2 imageSize = vec2(ubuf.imageWidth, ubuf.imageHeight);
        vec2 noiseTexSize = vec2(ubuf.noiseTexWidth, ubuf.noiseTexHeight);
        vec2 noiseRandomOffset = vec2(ubuf.noiseRandomOffsetX, ubuf.noiseRandomOffsetY);
        currentColor = processNoise(currentColor,
                                    vTexCoord,
                                    imageSize,
                                    noiseTexSize,
                                    noiseRandomOffset);
    }

    if (ubuf.hdrInvertTransfer == 1)
        currentColor.rgb = ColorRangeInvertTransfer(currentColor.rgb, 1);

    fragColor = currentColor;
}


// ===== #280 off=0x0744744 stage=vert len=5358 =====
#version 440

layout(location = 0) in vec2 vTexCoord;

layout(location = 0) out mediump vec4 fragColor;

layout(std140, binding = 0) uniform UniformBlock {
    // Lut
    mediump int lutOn;
    mediump int lutCount;
    mediump float lutIntensity;
    mediump float lutHdrTonemapExposure;
    mediump float lutHdrTonemapGamma;

    mediump float lutTexelSize1D; // 1 / (level count)
    mediump float lutRgbToTexCoordRatio;
    mediump int lutIsRGBLayout;

    mediump float lutTexelSize1D2; // 1 / (level count)
    mediump float lutRgbToTexCoordRatio2;
    mediump int lutIsRGBLayout2;

    mediump float endLutIntensity;

    // Noise
    mediump int noiseOn;
    mediump int colorNoise;
    mediump float colorRatio;
    mediump float noiseTexWidth;
    mediump float noiseTexHeight;
    mediump float noiseRandomOffsetX;
    mediump float noiseRandomOffsetY;
    mediump float noiseAmount;
    mediump float noiseHighlight;
    mediump float noiseMidtone;
    mediump float noiseMidtoneHigh;
    mediump float noiseShadow;
    mediump float noiseSize;
    mediump float noiseRoughness;
    mediump int noiseUseNewCurve;
    mediump float noiseScale;

    // PT400
    mediump float blurIntensity;
    mediump int isSDR;
    mediump int needLayer2;

    // Common
    mediump float imageWidth;
    mediump float imageHeight;
    mediump int hdrTransfer;
    mediump int hdrInvertTransfer;  // TODO.
} ubuf;

layout(binding = 2) uniform mediump sampler2D texSampler;
layout(binding = 3) uniform mediump sampler2D lutSampler;
layout(binding = 4) uniform mediump sampler2D lutSampler2;
layout(binding = 5) uniform mediump sampler2D noiseSampler;
layout(binding = 6) uniform mediump sampler2D auxSampler;
layout(binding = 7) uniform mediump sampler2D layerSampler1;
layout(binding = 8) uniform mediump sampler2D layerSampler2;

#extension GL_GOOGLE_include_directive:enable
#include "../hdr.inc.shader"
#include "../compoundLutCommon.inc.shader"
#include "../common.inc.shader"
#include "../blend.inc.shader"

void main()
{
    mediump vec4 currentColor = texture(texSampler, vTexCoord);

    if (ubuf.hdrTransfer == 1)
        currentColor.rgb = ColorRangeTransfer(currentColor.rgb, 1);

    mediump vec4 oriColor = currentColor;

    // low quality
    if (ubuf.blurIntensity > 0) {
        mediump vec4 blurColor = texture(auxSampler, vTexCoord);
        if (ubuf.hdrTransfer == 1)
            blurColor.rgb = ColorRangeTransfer(blurColor.rgb, 1);
        currentColor.rgb = mix(currentColor.rgb, blurColor.rgb, ubuf.blurIntensity);
    }

    //process lut
    if (ubuf.lutOn == 1) {
        if (ubuf.lutCount > 1) {
            // we need apply expo lut firstly
            mediump vec3 lutColor = lut3D2446A(currentColor.rgb,
                                               ubuf.lutTexelSize1D2,
                                               ubuf.lutRgbToTexCoordRatio2,
                                               ubuf.endLutIntensity,
                                               ubuf.lutIsRGBLayout2,
                                               ubuf.lutHdrTonemapExposure,
                                               ubuf.lutHdrTonemapGamma);
            currentColor.rgb = lut3D2446A2(lutColor,
                                           ubuf.lutTexelSize1D,
                                           ubuf.lutRgbToTexCoordRatio,
                                           ubuf.lutIntensity,
                                           ubuf.lutIsRGBLayout,
                                           ubuf.lutHdrTonemapExposure,
                                           ubuf.lutHdrTonemapGamma);
        } else {
            currentColor.rgb = lut3D2446A(currentColor.rgb,
                                          ubuf.lutTexelSize1D,
                                          ubuf.lutRgbToTexCoordRatio,
                                          ubuf.lutIntensity,
                                          ubuf.lutIsRGBLayout,
                                          ubuf.lutHdrTonemapExposure,
                                          ubuf.lutHdrTonemapGamma);
        }
    }

    if (ubuf.noiseOn == 1) {
        vec2 imageSize = vec2(ubuf.imageWidth, ubuf.imageHeight);
        vec2 noiseTexSize = vec2(ubuf.noiseTexWidth, ubuf.noiseTexHeight);
        vec2 noiseRandomOffset = vec2(ubuf.noiseRandomOffsetX, ubuf.noiseRandomOffsetY);
        currentColor = processNoise(currentColor,
                                    vTexCoord * ubuf.noiseScale,
                                    imageSize,
                                    noiseTexSize,
                                    noiseRandomOffset);
    }

    // layer
    if (ubuf.hdrTransfer == 1)
        currentColor.rgb = toneMapFwd(currentColor.rgb, 1.0f / 2.5f, 0.75f, true);
    mediump vec4 layer = texture(layerSampler1, vTexCoord);
    currentColor = softlight(layer, currentColor);

    if (ubuf.needLayer2 > 0) {
        layer = texture(layerSampler2, vTexCoord);
        currentColor = screen(layer, currentColor);
    }
    if (ubuf.hdrTransfer == 1)
        currentColor.rgb = toneMapBwd(currentColor.rgb, 1.0f / 2.5f, 0.75f, true);

    currentColor.rgb = mix(oriColor.rgb, currentColor.rgb, ubuf.lutIntensity);

    if (ubuf.hdrInvertTransfer == 1)
        currentColor.rgb = ColorRangeInvertTransfer(currentColor.rgb, 1);

    fragColor = currentColor;
}
